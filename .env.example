# OpenRouter — one key for GPT, Claude, Gemini, and Grok
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ElevenLabs — text-to-speech for each AI player
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Voice IDs from https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_CHATGPT=
ELEVENLABS_VOICE_CLAUDE=
ELEVENLABS_VOICE_GEMINI=
ELEVENLABS_VOICE_GROK=

# Optional: override OpenRouter model slugs (defaults are sensible picks)
# OPENROUTER_MODEL_CHATGPT=openai/gpt-4o
# OPENROUTER_MODEL_CLAUDE=anthropic/claude-sonnet-4
# OPENROUTER_MODEL_GEMINI=google/gemini-2.0-flash-001
# OPENROUTER_MODEL_GROK=x-ai/grok-4.3
